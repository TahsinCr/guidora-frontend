# ========================================================
# Guidora Frontend - Environment Variable Template
# Copy this file to .env.development or .env.production
# ========================================================

# 1. API Infrastructure
# In dev: uses Vite reverse proxy to localhost:8080 (or your .NET port)
# In production: either relative '/api' for Docker reverse proxy or full domain 'https://api.guidora.io/api'
VITE_API_BASE_URL=/api

# 2. Environment & Versioning
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# 3. Backend Integration & Fallback Controls
# Set to 'false' in production so that real API failure is explicitly surfaced
VITE_ALLOW_MOCK_FALLBACK=true

# 4. Security & Optimization
# If true, console.log and debug outputs are purged during production rollup build
VITE_DROP_CONSOLE=false
