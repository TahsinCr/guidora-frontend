# ========================================================
# Guidora Frontend - Environment Variable Template
# Copy this file to .env and adjust values for your environment
# ========================================================

# 1. Backend API Connection & Routing
# In development: uses relative '/api' proxy forwarding to VITE_BACKEND_URL
# In production: either relative '/api' (Nginx reverse proxy) or full API origin (e.g. https://api.guidora.io/api)
VITE_API_BASE_URL=/api

# Real .NET 10 WebAPI backend server address (Target for Vite dev proxy)
# Defaults to localhost:8080 (Docker default) or https://localhost:7182 (launchSettings default)
VITE_BACKEND_URL=http://localhost:8080

# 2. Environment & Application Versioning
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# 3. Failover & Resilience
# Set to 'false' in production so genuine server connectivity errors are explicitly reported
VITE_ALLOW_MOCK_FALLBACK=true

# 4. Security & Optimization
# If true, console.log and debug traces are purged from production rollup build
VITE_DROP_CONSOLE=false
