{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guidora Runtime Configuration",
  "app": {
    "siteName": "Guidora",
    "supportEmail": "support@guidora.io",
    "defaultLocale": "tr",
    "availableLocales": ["tr", "en", "ru"]
  },
  "backend": {
    "healthCheckEndpoint": "/health/live",
    "healthReadyEndpoint": "/health/ready",
    "apiPrefix": "/api"
  },
  "network": {
    "timeouts": {
      "defaultMs": 8000,
      "uploadMs": 25000,
      "authMs": 6000,
      "healthCheckMs": 3000
    },
    "retry": {
      "maxRetries": 2,
      "backoffBaseMs": 1000,
      "retryableStatusCodes": [408, 429, 500, 502, 503, 504]
    },
    "rateLimiting": {
      "respectRetryAfter": true,
      "knownLimits": {
        "loginPerMinute": 60,
        "registerPerHour": 20,
        "refreshPerMinute": 60
      },
      "retryAfterFallbackSeconds": 15
    }
  },
  "circuitBreaker": {
    "enabled": true,
    "failureThreshold": 5,
    "recoveryTimeoutMs": 20000,
    "probeIntervalMs": 10000,
    "healthEndpoint": "/health/live"
  },
  "toasts": {
    "autoDismissMs": 3000,
    "allowUserClose": true
  },
  "ambientBar": {
    "enabled": true,
    "heightPx": 2.5
  },
  "maintenance": {
    "active": false,
    "scheduled": false,
    "title": "Planlı Bakım Çalışması",
    "activeDescription": "Guidora platformunda planlı altyapı optimizasyonu ve güvenlik güncellemeleri yapılmaktadır. Çalışmaların en kısa sürede tamamlanarak tüm servislerin yeniden erişime açılması planlanmaktadır. Anlayışınız için teşekkür ederiz.",
    "scheduledWarningDescription": "Guidora platformu saat 20:00 itibarıyla planlı performans bakımına alınacaktır. Çalışmaların yaklaşık 45 dakika sürmesi öngörülmektedir. Lütfen işlemlerinizi tamamlayınız.",
    "scheduledStart": null,
    "scheduledCountdownSeconds": 3600,
    "estimatedEndTime": null,
    "bypassKeys": ["superadmin_preview", "guidora_dev_2026"],
    "bypassRoles": ["admin", "superadmin"]
  },
  "features": {
    "toolSubmission": {
      "enabled": true,
      "requiresEmailVerification": false,
      "allowGithubImport": true
    },
    "communityReviews": {
      "enabled": true,
      "minAccountAgeDays": 7,
      "requiresEmailVerification": true
    },
    "communityVerificationVoting": {
      "enabled": true,
      "voteThreshold": 30,
      "requiresEmailVerification": true
    },
    "compareMode": true
  }
}
